import crypto from 'crypto';
import { query } from './pg';

export interface DbUser {
  id: string;
  email: string;
  name: string;
  role: string;
  totalEnergyUsed: number;
  createdAt: string;
}

// User operations
export async function findUserById(userId: string) {
  const res = await query('SELECT * FROM users WHERE id = $1', [userId]);
  if (res.rows.length === 0) return null;
  const u = res.rows[0];
  return {
    id: u.id,
    email: u.email,
    name: u.name,
    role: u.role,
    totalEnergyUsed: Number(u.total_energy_used || 0),
    createdAt: u.created_at,
  };
}

export async function findUserByEmail(email: string) {
  const res = await query('SELECT * FROM users WHERE email = $1', [email]);
  if (res.rows.length === 0) return null;
  const u = res.rows[0];
  return {
    id: u.id,
    email: u.email,
    name: u.name,
    password: u.password,
    role: u.role,
    totalEnergyUsed: Number(u.total_energy_used || 0),
    createdAt: u.created_at,
  };
}

export async function createUser(user: any) {
  await query(
    'INSERT INTO users (id, email, password, name, role, total_energy_used, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7)',
    [
      user.id,
      user.email,
      user.password,
      user.name,
      user.role || 'user',
      user.totalEnergyUsed || 0,
      user.createdAt || new Date(),
    ]
  );
  return user;
}

export async function updateUser(userId: string, updates: any) {
  const fields: string[] = [];
  const params: any[] = [];
  let idx = 1;

  if (updates.name !== undefined) {
    fields.push(`name = $${idx++}`);
    params.push(updates.name);
  }
  if (updates.role !== undefined) {
    fields.push(`role = $${idx++}`);
    params.push(updates.role);
  }
  if (updates.totalEnergyUsed !== undefined) {
    fields.push(`total_energy_used = $${idx++}`);
    params.push(updates.totalEnergyUsed);
  }

  if (fields.length === 0) return findUserById(userId);

  params.push(userId);
  await query(
    `UPDATE users SET ${fields.join(', ')} WHERE id = $${idx}`,
    params
  );
  return findUserById(userId);
}

// readUsers gets all users
export async function readUsers() {
  const res = await query('SELECT * FROM users ORDER BY created_at DESC');
  return res.rows.map(u => ({
    id: u.id,
    email: u.email,
    name: u.name,
    role: u.role,
    totalEnergyUsed: Number(u.total_energy_used || 0),
    createdAt: u.created_at,
  }));
}

