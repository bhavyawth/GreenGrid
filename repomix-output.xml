/**
 * Server-side blockchain service.
 * All functions here run exclusively in Node.js (never in the browser).
 * Wraps viem contract reads/writes with clean error handling.
 */
import { keccak256, stringToBytes, type Address, type Hash } from 'viem';
import {
  publicClient,
  getWalletClient,
  CONTRACT_ADDRESS,
  CHAIN_ID,
  EXPLORER_URL,
  isWalletConfigured,
  localChain,
} from './client';
import { carbonCreditAbi } from './abi';

// ─────────────────────────────────────────────────────────────────────────────
// Types
// ─────────────────────────────────────────────────────────────────────────────

export interface BlockchainStatus {
  connected: boolean;
  network: string;
  chainId: number;
  contractAddress: string;
  explorerUrl: string;
  walletConfigured: boolean;
  blockNumber?: string;
  error?: string;
}

export interface ProjectData {
  tokenId: string;
  metadataCID: string;
  issuer: string;
  carbonReduction: string;
  verifiedAt: string;
  evidenceHash: string;
  attestationCount: string;
