# ─── Public (safe to expose to browser) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=/api

# ─── Blockchain (server-side only — NEVER prefix with NEXT_PUBLIC_) ──────────
# Polygon Amoy RPC URL (get a free key from https://alchemy.com)
BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployed CarbonCredit contract address (Polygon Amoy)
BLOCKCHAIN_CONTRACT_ADDRESS=0xcf7ed3acca5a467e9e704c703e8d87f634fb0fc9

# Polygon Amoy chain ID
BLOCKCHAIN_CHAIN_ID=80002

# Server wallet private key — required for write transactions (registerProject, verify, etc.)
# Get testnet MATIC from https://faucet.polygon.technology/
# WARNING: Never commit a real private key. Use secrets management in production.
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY_HERE

# ─── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://YOUR_BROKER_IP:1883
MQTT_TOPIC=energy/ESP32-001
IOT_DEVICE_ID=ESP32-001

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production

# ─── AI Service (server-side only — NEVER prefix with NEXT_PUBLIC_) ──────────
AI_SERVICE_URL=http://localhost:8000

